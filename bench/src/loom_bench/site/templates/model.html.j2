{% extends "base.html.j2" %}
{% from "_macros.html.j2" import money, estimate, link_list %}
{% from "_site.html.j2" import pending, scroll_table, cost, point, price_pair, gate_badge, note_list %}
{% set snap = model.snap %}
{% block title %}{{ snap.display_name }} · Loom results{% endblock %}
{% block description %}Benchmark results for {{ snap.display_name }} on Loom: cost per token at SLO with confidence intervals, quality gate, cold start, exact configs and provenance.{% endblock %}
{% block content %}
<header class="page-head">
<p class="eyebrow"><a href="{{ root }}index.html">Results</a> / Model</p>
<h1>{{ snap.display_name }}</h1>
<dl class="meta">
<dt>Our price</dt><dd>{% if model.price %}<strong>{{ price_pair(model.price) }}</strong> per 1M tokens, input / output (planned){% else %}Not offered (no price set){% endif %}</dd>
{% if snap.repo %}<dt>Weights</dt><dd><a href="https://huggingface.co/{{ snap.repo }}">{{ snap.repo }}</a>{% if model.revision %} at <code>{{ model.revision }}</code>{% endif %}</dd>{% endif %}
{% if model.planned %}
<dt>Serving</dt><dd>{{ model.planned.short }} · {{ model.planned.engine }}</dd>
<dt>License</dt><dd>{{ model.planned.license }}</dd>
<dt>Status</dt><dd>{{ model.planned.status }}</dd>
{% endif %}
</dl>
</header>

{% if not model.boards %}
{{ pending("This model is queued for benchmarking. Its results, quality gate, cold start and provenance appear here once the first runs are published.") }}
{% if model.planned %}
<section aria-labelledby="planned-h">
<h2 id="planned-h">Configuration to be benchmarked</h2>
<dl class="defs compact">
<dt>Engine</dt><dd>{{ model.planned.engine }}</dd>
<dt>Image</dt><dd><code>{{ model.planned.image }}</code></dd>
<dt>Hardware</dt><dd>{{ model.planned.hardware }}</dd>
<dt>Parallelism</dt><dd>{{ model.planned.parallelism }}</dd>
<dt>Precision</dt><dd>{{ model.planned.quantization }}</dd>
<dt>Max context</dt><dd>{{ model.planned.max_context|num }} tokens</dd>
</dl>
<h3 id="registry-h">Registry entry</h3>
<p class="section-note">From <a href="{{ registry_url }}">config/models.yaml</a>. Engine images are pinned by digest, weights by commit.</p>
<pre class="code" tabindex="0" aria-labelledby="registry-h"><code>{{ snap.registry|yaml }}</code></pre>
</section>
{% endif %}
{% else %}
<nav class="toc" aria-label="Workloads on this page">
<p>Workloads:</p>
<ul>
{% for b in model.boards %}
<li><a href="#{{ b.anchor }}">{{ b.board.workload }}</a></li>
{% endfor %}
</ul>
</nav>
<p class="section-note">Each workload lists every config we ran, cheapest first. Ranked configs passed every check; the rest follow with the reason. Costs are per 1M tokens at on-demand GPU prices (storage included), split between input and output by measured prefill time (<a href="{{ root }}methodology.html#split">how</a>). Small grey numbers are 95% confidence intervals (<a href="{{ root }}methodology.html#ci">how</a>).</p>

{% for b in model.boards %}
{% set first = b.configs[0].result %}
{% set notes = namespace(list=[], prefix=b.anchor ~ '-') %}
<section aria-labelledby="{{ b.anchor }}">
<h2 id="{{ b.anchor }}">{{ b.board.workload }}</h2>
<p class="section-note">{% if b.board.content %}{{ b.board.content.value|sentence }} text{% if b.shape %}, {% endif %}{% endif %}{{ b.shape or '' }}{% if b.board.content or b.shape %}. {% endif %}Load: {{ load_mode_label(b.board.load_mode) }}. SLO: {{ describe_slo(first.goodput.slo) }}.</p>
<p class="quoted">{% if b.head and b.head.rank is not none %}Best config at SLO: <strong>{{ b.head.result.name }}</strong>.{% elif b.head %}No config ranked. Shown as a comparison point, not as the best config: <strong>{{ b.head.result.name }}</strong>, {{ unranked_reason(b.head.result) }}.{% else %}No config ranked. {{ b.basis|sentence }}.{% endif %}</p>
{% call scroll_table(b.anchor) %}
<table class="leaderboard">
<thead>
<tr><th scope="col" class="num">#</th><th scope="col">Config</th><th scope="col" class="num">Cost in</th><th scope="col" class="num">Cost out</th><th scope="col" class="num"><abbr title="The cost leaderboards are ordered by: $/1M {{ b.board.side }} with the whole replica charged under {{ b.rank_allocation }}, at the on-demand price. Not a price.">Rank key</abbr><span class="unit">$/1M {{ b.board.side }}, {{ b.rank_allocation }}</span></th><th scope="col" class="num"><abbr title="Output tokens per second per GPU at the highest load that met the SLO">Throughput</abbr><span class="unit">tok/s per GPU</span></th><th scope="col" class="num"><abbr title="Time to first token, 95th percentile, at the goodput load">First token</abbr><span class="unit">p95</span></th><th scope="col" class="num"><abbr title="Time per output token after the first, 95th percentile, at the goodput load">Per token</abbr><span class="unit">p95</span></th><th scope="col">Quality</th></tr>
</thead>
<tbody>
{% for c in b.configs %}
{% set row = c.row %}
{% set r = c.result %}
{% set split_in, split_out, _ = split_ranges(r) %}
<tr class="{{ 'ranked' if row.rank is not none else 'unranked' }}">
<td class="num">{{ row.rank if row.rank is not none else '–' }}</td>
<td class="cfg"><a href="#{{ c.anchor }}"><strong>{{ r.name }}</strong></a>{% if row.rank is none %} <span class="badge {{ row.status.name|lower }}">{{ row.status.value }}</span>{% endif %}<span class="sub">{{ r.label.short }}</span></td>
<td class="num">{{ cost(split_in, notes, ci=true) }}</td>
<td class="num">{{ cost(split_out, notes, ci=true) }}</td>
<td class="num">{{ cost(ranking_cost(r), notes, ci=true) }}</td>
<td class="num">{{ point(r.goodput_output_tok_s_per_gpu, 1, ci=true) }}</td>
<td class="num">{{ point(r.ttft_p95_ms, 0, 'ms', ci=true) }}</td>
<td class="num">{{ point(r.tpot_p95_ms, 1, 'ms', ci=true) }}</td>
<td class="gate">{{ gate_badge(r, ref=true) }}{% if r.quality and r.quality.gate %}{% set worst = r.quality.worst() %}{% if worst %}<span class="sub">worst Δ {{ '%+.3f'|format(worst.delta) }} ({{ worst.task }})</span>{% endif %}{% if r.quality.gate == 'review' %}<span class="sub"><a href="#{{ c.anchor }}-quality">divergence above limit</a></span>{% endif %}{% elif r.quality and r.quality.tasks %}<span class="sub">{% for t in r.quality.tasks %}{{ t.task }} {{ '%.3f'|format(t.score) }}{% if not loop.last %}, {% endif %}{% endfor %}</span>{% endif %}</td>
</tr>
{% endfor %}
</tbody>
</table>
{% endcall %}
{{ note_list(notes) }}
{% if any_unbracketed(b.configs|map(attribute='result.goodput')) %}<p class="section-note">{{ unbracketed_note }}</p>{% endif %}
<details class="more">
<summary id="{{ b.anchor }}-more">Load, blended cost, spot and as-run prices, cold start</summary>
{% call scroll_table(b.anchor ~ '-more') %}
<table class="more">
<thead>
<tr><th scope="col">Config</th><th scope="col" class="num">Load at goodput</th><th scope="col" class="num">$/1M blended at this mix</th>{% for col in b.board.price_columns %}<th scope="col" class="num">{{ price_header(col, b.board.side) }}</th>{% endfor %}<th scope="col" class="num">Cold start</th></tr>
</thead>
<tbody>
{% for c in b.configs %}
{% set r = c.result %}
{% set _, _, blended = split_ranges(r) %}
<tr class="{{ 'ranked' if c.row.rank is not none else 'unranked' }}">
<td class="cfg"><a href="#{{ c.anchor }}">{{ r.name }}</a></td>
<td class="num">{{ goodput_load(r.goodput) }}</td>
<td class="num">{{ money(blended) }}</td>
{% for col in b.board.price_columns %}<td class="num">{{ money(ranking_cost(r, col)) }}</td>{% endfor %}
<td class="num">{{ cold_text(c.row.cold_start) }}</td>
</tr>
{% endfor %}
</tbody>
</table>
{% endcall %}
</details>

<p class="label" id="{{ b.anchor }}-configs">Config details, provenance and how to reproduce:</p>
{% for c in b.configs %}
{% set r = c.result %}
{% set p = c.provenance %}
<details class="config" id="{{ c.anchor }}">
<summary><h3>{{ r.name }}</h3> <span class="badge {{ c.row.status.name|lower }}">{{ c.row.status.value }}</span> {{ gate_badge(r) }}<span class="rec">{{ c.row.recommendation }}.</span></summary>
<dl class="defs compact">
<dt>Config</dt><dd>{{ r.label.text }}<span class="sub">config hash <code>{{ r.config_hash }}</code></span></dd>
<dt>Precision</dt><dd>{{ r.label.precision_text }}</dd>
{% if r.quality and r.quality.gate and r.quality.gate != 'baseline' %}<dt>Quality reference</dt><dd>{{ r.quality.baseline_text }}<span class="sub">config hash <code>{{ r.quality.baseline_config_hash }}</code></span></dd>{% endif %}
<dt>Engine</dt><dd>{{ p.engine }}; image <code>{{ p.image or 'not recorded' }}</code></dd>
<dt>Model</dt><dd>{{ p.model }}</dd>
<dt>Hardware</dt><dd>{{ p.gpu }} · {{ p.location }}; CUDA {{ p.cuda_version or 'not recorded' }}, driver {{ p.driver_version or 'not recorded' }}</dd>
<dt>Workload content</dt><dd>{{ r.content.value if r.content else 'not recorded' }}</dd>
<dt>Goodput</dt><dd>{{ load_value(r.goodput.max_load, r.load_mode) }}{% if r.goodput.first_failing_load is not none %}; first failing load {{ load_value(r.goodput.first_failing_load, r.load_mode) }}{% else %}; no tested load failed, so goodput may be higher{% endif %}</dd>
<dt>Raw peak</dt><dd>{{ r.peak_output_tok_s|est(1) }} output tok/s at {{ load_value(r.peak_load, r.load_mode) }} (SLO ignored; not used for cost)</dd>
<dt>Hourly price</dt><dd>{{ p.price.basis }}{% if p.price.urls %}; source: {{ link_list(p.price.urls) }}{% endif %}{% if p.price.last_checked %}; last checked {{ p.price.last_checked }}{% endif %}{% if p.price.note %}; {{ p.price.note }}{% endif %}</dd>
<dt>Price as run</dt><dd>{{ p.price.as_run }}</dd>
<dt>Cost allocation</dt><dd>ranked under {{ r.allocation }}; $/1M input and output split by measured prefill time{% if r.split_cost and r.split_cost.input_time_share %} (φ = {{ r.split_cost.input_time_share|est(3) }} of the replica's time on input){% endif %} (<a href="{{ root }}methodology.html#split">methodology</a>)</dd>
<dt>Cold start</dt><dd>{{ cold_text(c.row.cold_start) }}</dd>
<dt>Code</dt><dd>commit {% for s in p.git_shas %}<code>{{ s }}</code>{{ ', ' if not loop.last }}{% else %}not recorded{% endfor %}; loom-bench {{ p.bench_version or 'not recorded' }}</dd>
</dl>
{% if r.warnings %}
<ul class="warnings">
{% for w in r.warnings %}
<li>{{ w.message }}</li>
{% endfor %}
</ul>
{% endif %}
{% if r.quality and r.quality.tasks %}
<h4 id="{{ c.anchor }}-quality">Quality</h4>
{% call scroll_table(c.anchor ~ '-quality') %}
<table>
<thead><tr><th scope="col">Task</th><th scope="col" class="num">n</th><th scope="col" class="num">Score</th><th scope="col" class="num">Baseline</th><th scope="col" class="num">Δ vs baseline</th></tr></thead>
<tbody>
{% for t in r.quality.tasks %}
<tr><td>{{ t.task }}{% if t.task_version %}<span class="sub">version {{ t.task_version }}</span>{% endif %}{% if t.note %}<span class="sub">{{ t.note }}</span>{% endif %}</td><td class="num">{{ t.n|num }}</td><td class="num">{{ t.score|num(3) }}{% if t.ci_low is not none and t.ci_high is not none %}<span class="ci">{{ t.ci_low|num(3) }} – {{ t.ci_high|num(3) }}</span>{% endif %}</td><td class="num">{{ t.baseline_score|num(3) }}</td><td class="num">{{ '%+.3f'|format(t.delta) if t.delta is not none else 'n/a' }}</td></tr>
{% endfor %}
</tbody>
</table>
{% endcall %}
{% if r.quality.divergence %}
<p class="section-note">Logprob divergence from the baseline{% if r.quality.gate == 'review' %} (needs review: every task passed, but the divergence is above its limit){% endif %}: {{ r.quality.divergence.text() }}. <a href="{{ root }}methodology.html#quality">How the limits are set</a></p>
{% endif %}
{% endif %}
<h4 id="{{ c.anchor }}-points">Load sweep</h4>
{% call scroll_table(c.anchor ~ '-points') %}
<table>
<thead><tr><th scope="col" class="num">Load</th><th scope="col" class="num">Repetitions</th><th scope="col">SLO</th><th scope="col" class="num">p95 TTFT ms</th><th scope="col" class="num">p95 TPOT ms</th><th scope="col" class="num">Output tok/s</th><th scope="col" class="num">Error rate</th></tr></thead>
<tbody>
{% for pt in r.points %}
{% set err = pt.aggregate.get('error_rate') %}
<tr><td class="num">{{ load_value(pt.load, r.load_mode) }}</td><td class="num">{{ pt.aggregate.n_runs }}</td><td>{% if c.met[pt.load] %}<span class="badge pass">met</span>{% else %}<span class="badge fail">missed</span>{% endif %}</td><td class="num">{{ estimate(pt.aggregate.get('ttft_ms.p95'), 0) }}</td><td class="num">{{ estimate(pt.aggregate.get('tpot_ms.p95'), 1) }}</td><td class="num">{{ estimate(pt.aggregate.get('throughput.output_tok_s'), 1) }}</td><td class="num">{{ (err.mean|pct) if err is not none else 'n/a' }}</td></tr>
{% endfor %}
</tbody>
</table>
{% endcall %}
<h4 id="{{ c.anchor }}-yaml">Config</h4>
<pre class="code" tabindex="0" aria-labelledby="{{ c.anchor }}-yaml"><code>{{ c.config_yaml }}</code></pre>
<h4 id="{{ c.anchor }}-reproduce">Reproduce</h4>
<pre class="code" tabindex="0" aria-labelledby="{{ c.anchor }}-reproduce"><code>{{ p.reproduce }}</code></pre>
<details>
<summary id="{{ c.anchor }}-runs-h">Runs and provenance ({{ p.runs }} run{{ '' if p.runs == 1 else 's' }})</summary>
<p class="section-note">Each file holds the run's summary and its provenance record as stored; sha256 of the record's canonical JSON is its digest.</p>
{% call scroll_table(c.anchor ~ '-runs-h') %}
<table>
<thead><tr><th scope="col" class="num">Load</th><th scope="col" class="num">Repetition</th><th scope="col">Provenance</th></tr></thead>
<tbody>
{% for pt, run_id, rep in c.runs() %}
<tr><td class="num">{{ load_value(pt.load, r.load_mode) }}</td><td class="num">{{ rep if rep is not none else '–' }}</td><td><a href="{{ root }}data/provenance/{{ run_id }}.json"><code>{{ run_id }}</code></a></td></tr>
{% endfor %}
</tbody>
</table>
{% endcall %}
</details>
</details>
{% endfor %}
</section>
{% endfor %}
<script>
// Open the config a link points at: its details are collapsed by default.
(function () {
  function open() { var el = location.hash && document.getElementById(location.hash.slice(1)); var d = el && el.closest("details"); while (d) { d.open = true; d = d.parentElement.closest("details"); } if (el) el.scrollIntoView(); }
  window.addEventListener("hashchange", open);
  open();
})();
</script>
{% endif %}
{% endblock %}
