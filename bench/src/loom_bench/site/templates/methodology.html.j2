{% else %}
<p class="notice-inline">Illustrative: the throughput below is a round number chosen to show the arithmetic, not a measurement. The price is real: {{ example.source }} ({{ example.instance }}), from the <a href="#prices">price book</a>.</p>
{% endif %}
<dl class="defs compact worked">
<dt>Hourly price</dt><dd class="num-text">{{ example.hourly_micros|usd(4) }} per hour (on-demand, storage included)</dd>
<dt>Goodput output throughput</dt><dd class="num-text">{{ example.output_tok_s|num(1) }} tok/s{% if not example.measured %} (illustrative){% endif %}</dd>
<dt>Output tokens per hour</dt><dd class="num-text">{{ example.output_tok_s|num(1) }} × {{ seconds_per_hour|num }} = {{ (example.output_tok_s * seconds_per_hour)|num }}</dd>
<dt>$/1M output tokens</dt><dd class="num-text">{{ example.hourly_micros|usd(4) }} ÷ {{ (example.output_tok_s * seconds_per_hour)|num }} × {{ tokens_per_mtok|num }} = <strong>{{ example.output_per_mtok|usd(4) }}</strong></dd>
</dl>
