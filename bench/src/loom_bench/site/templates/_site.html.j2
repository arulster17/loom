{% macro waitlist(config) %}
{% set w = config.waitlist %}
<section class="waitlist" aria-labelledby="waitlist-h">
<h2 id="waitlist-h">Waitlist</h2>
{% if w.enabled %}
<p>Loom's API is not open yet. Leave an email address to hear when it is.</p>
<form id="waitlist-form" action="{{ w.action_url }}" method="{{ w.method|lower }}">
<label for="waitlist-email">Email address</label>
<div class="field-row">
<input id="waitlist-email" name="{{ w.field }}" type="email" required autocomplete="email" spellcheck="false">
<button type="submit">Join the waitlist</button>
</div>
<div class="hp" aria-hidden="true">
<label for="waitlist-hp">Leave this field empty</label>
<input id="waitlist-hp" name="{{ w.honeypot }}" type="text" tabindex="-1" autocomplete="off">
</div>
{% for name, value in w.extra_fields.items() %}
<input type="hidden" name="{{ name }}" value="{{ value }}">
{% endfor %}
<p class="privacy">We only use this to tell you when Loom opens; no sharing.</p>
<p class="form-status" id="waitlist-status" role="status" aria-live="polite"></p>
</form>
<script>
(function () {
  var form = document.getElementById("waitlist-form");
  var status = document.getElementById("waitlist-status");
  if (!form || !window.fetch || !window.FormData) return;
  form.addEventListener("submit", function (event) {
    event.preventDefault();
    var button = form.querySelector("button");
    var done = function (ok, text) { status.textContent = text; status.className = "form-status " + (ok ? "ok" : "error"); button.disabled = false; };
    if (form.elements["{{ w.honeypot }}"].value) { done(true, "Thanks. You're on the list."); return; }
    button.disabled = true;
    status.className = "form-status";
    status.textContent = "Sending…";
    var data = new FormData(form);
    var get = form.method.toLowerCase() === "get";
    var url = get ? form.action + (form.action.indexOf("?") < 0 ? "?" : "&") + new URLSearchParams(data) : form.action;
    fetch(url, { method: form.method.toUpperCase(), body: get ? undefined : data, headers: { Accept: "application/json" } })
      .then(function (r) { done(r.ok, r.ok ? "Thanks. You're on the list." : "That didn't go through (HTTP " + r.status + "). Please try again."); if (r.ok) form.reset(); })
      .catch(function () { done(false, "Couldn't reach the signup service. Check your connection and try again."); });
  });
})();
</script>
{% else %}
<p><strong>Waitlist opens soon.</strong> The API is not open and there is no signup form yet. Watch <a href="{{ config.repo }}">{{ config.repo.removeprefix('https://') }}</a> for news.</p>
{% endif %}
</section>
{% endmacro %}

{% macro pending(text) %}
<div class="notice" role="note"><p><strong>No published results yet — first runs pending.</strong> {{ text }}</p></div>
{% endmacro %}

{% macro scroll_table(label_id) %}
<div class="table-wrap" role="region" aria-labelledby="{{ label_id }}" tabindex="0">
{{ caller() }}
</div>
{% endmacro %}

{# Numbered notes under a table. `notes` is a namespace(list=[], prefix='...'): each
   distinct note gets one number, and the cell carries its marker. #}
{% macro note_mark(text, note, notes, title='') -%}
{% if note not in notes.list %}{% set notes.list = notes.list + [note] %}{% endif %}
{% set n = notes.list.index(note) + 1 %}<span{% if title %} title="{{ title }}"{% endif %}>{{ text }}</span><sup class="fn"><a href="#note-{{ notes.prefix }}{{ n }}" aria-label="note {{ n }}">{{ n }}</a></sup>
{%- endmacro %}

{% macro note_list(notes) %}
{% if notes.list %}
<ol class="notes">
{% for note in notes.list %}
<li id="note-{{ notes.prefix }}{{ loop.index }}">{{ note|sentence }}.</li>
{% endfor %}
</ol>
{% endif %}
{% endmacro %}

{# A cost's point value; its 95% CI in a tooltip, or (ci=true) on a muted second line. #}
{% macro cost(rng, notes, ci=false) -%}
{% if rng is not none and rng.na_reason %}{{ note_mark('n/a', rng.na_reason, notes) }}{% elif rng is none or rng.value is none %}n/a{% else %}{% if rng.lo_note %}{{ note_mark(rng.value|usd, '95% CI ' ~ rng.lo_note, notes, '' if ci else ci_title(rng)) }}{% elif ci %}{{ rng.value|usd }}{% else %}<span title="{{ ci_title(rng) }}">{{ rng.value|usd }}</span>{% endif %}{% if ci %}<span class="ci">{% if rng.lo is none and rng.hi is none %}no CI{% else %}{{ rng.lo|usd if rng.lo is not none else 'n/a' }} – {{ rng.hi|usd if rng.hi is not none else 'unbounded' }}{% endif %}</span>{% endif %}{% endif %}
{%- endmacro %}

{# An estimate's point value; its 95% CI in a tooltip, or (ci=true) on a muted second line. #}
{% macro point(e, places=0, unit='', ci=false) -%}
{% if e is none %}n/a{% else %}{% set p = places_for([e.mean, e.lo, e.hi], places) %}{% if ci %}{{ e.mean|num(p) }}{{ ' ' ~ unit if unit }}<span class="ci">{% if e.lo is none %}n={{ e.n }}, no CI{% else %}{{ e.lo|num(p) }} – {{ e.hi|num(p) }}{% endif %}</span>{% else %}<span title="{{ est_title(e, p) }}">{{ e.mean|num(p) }}{{ ' ' ~ unit if unit }}</span>{% endif %}{% endif %}
{%- endmacro %}

{% macro price_pair(p) -%}
{% if p is none %}n/a{% else %}{{ p.input_per_mtok|price_usd }} <span class="sep">/</span> {{ p.output_per_mtok|price_usd }}{% endif %}
{%- endmacro %}

{% macro gate_badge(r, ref=false) -%}
{% if r.quality and r.quality.gate %}<span class="badge {{ r.quality.gate }}">{{ 'BF16 reference' if r.quality.gate == 'baseline' else gate_label(r.quality.gate) }}</span>{% if ref and r.quality.gate != 'baseline' %}<span class="sub">vs {{ r.quality.baseline_text }}</span>{% endif %}{% elif r.quality and r.quality.tasks %}<span class="muted">scored, no gate</span>{% else %}<span class="muted">not evaluated</span>{% endif %}
{%- endmacro %}
