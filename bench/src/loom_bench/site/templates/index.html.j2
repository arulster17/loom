{% extends "base.html.j2" %}
{% from "_site.html.j2" import waitlist, pending, scroll_table, cost, point, price_pair, gate_badge, note_mark, note_list %}
{% block title %}Loom: measured cost per token for open-weight models{% endblock %}
{% block content %}
<header class="page-head">
<h1>Open-weight models, priced from measured cost</h1>
<p class="lede">Loom is an inference API for open-weight models. It is not open yet. We benchmark each model on our own GPUs and publish the cost, latency and quality behind every price.</p>
</header>

{% if manifest.empty %}
{{ pending("No GPU runs have been published yet. Planned prices and configurations are listed below; measurements fill in once the first runs complete.") }}
{% endif %}

<section aria-labelledby="models-h">
<h2 id="models-h">Models</h2>
<p class="section-note">Per 1M tokens, input / output. Prices are planned, from <a href="{{ registry_url }}">config/models.yaml</a>.</p>
{% set snotes = namespace(list=[], prefix='s') %}
{% call scroll_table("models-h") %}
<table class="summary">
<thead>
<tr><th scope="col">Model</th><th scope="col" class="num">Our price</th><th scope="col" class="num">Our measured cost</th><th scope="col" class="num">Lowest public list price</th><th scope="col">Quality</th></tr>
</thead>
<tbody>
{% for s in summaries %}
{% set m = s.model %}
<tr>
<th scope="row" class="model"><a href="{{ root }}{{ m.path }}">{{ m.snap.display_name }}</a>{% if m.planned %}<span class="sub">{{ m.planned.short }}</span>{% endif %}</th>
<td class="num" data-label="Our price"><div>{% if s.price %}<strong>{{ price_pair(s.price) }}</strong>{% else %}<span class="muted">Not offered</span><span class="sub">{{ s.not_offered }}</span>{% endif %}</div></td>
<td class="num" data-label="Our measured cost"><div>{% for c in s.costs %}<span class="line">{{ cost(c.cost_in, snotes) }} <span class="sep">/</span> {{ cost(c.cost_out, snotes) }}</span><span class="sub"><a href="{{ root }}{{ m.path }}#{{ c.board.anchor }}">{{ c.board.board.workload }}</a></span>{% else %}<span class="muted">{{ s.no_cost }}</span>{% endfor %}</div></td>
<td class="num" data-label="Lowest public list price"><div>{% if s.market %}{{ s.market.input_per_mtok|price_usd }} <span class="sep">/</span> {{ s.market.output_per_mtok|price_usd }}<span class="sub">{{ s.market.note }}</span>{% if s.market.listed_for %}<span class="sub">listed for {{ s.market.listed_for }}</span>{% endif %}{% else %}<span class="muted">none listed</span>{% endif %}</div></td>
<td data-label="Quality"><div><span class="badge {{ s.quality_class }}">{{ s.quality }}</span>{% if s.quality_note %}<span class="sub">{{ s.quality_note }}</span>{% endif %}</div></td>
</tr>
{% endfor %}
</tbody>
</table>
{% endcall %}
{{ note_list(snotes) }}
<p class="section-note">Measured cost is shown only for configs that are ranked (see below). Competitor prices are public list prices; we do not benchmark other providers. <a href="{{ root }}pricing.html">Full price comparison and margins</a></p>
</section>

{% if not manifest.empty %}
<section aria-labelledby="results-h">
<h2 id="results-h">Results by workload</h2>
<p class="section-note">Best config per workload at the SLO ({{ describe_slo(manifest.slo) if manifest.slo else 'not recorded' }}). Cost per 1M tokens at on-demand GPU prices. Model pages show every config with 95% confidence intervals.</p>
{% set notes = namespace(list=[], prefix='r') %}
{% call scroll_table("results-h") %}
<table class="headline">
<thead>
<tr><th scope="col">Workload</th><th scope="col">Config</th><th scope="col" class="num">Cost in</th><th scope="col" class="num">Cost out</th><th scope="col" class="num"><abbr title="Output tokens per second per GPU at the highest load that met the SLO">Throughput</abbr><span class="unit">tok/s per GPU</span></th><th scope="col" class="num"><abbr title="Time to first token, 95th percentile">First token</abbr><span class="unit">p95</span></th><th scope="col" class="num"><abbr title="Time per output token after the first, 95th percentile">Per token</abbr><span class="unit">p95</span></th><th scope="col">Quality</th></tr>
</thead>
{% for m in models if m.boards %}
<tbody>
<tr class="group"><th scope="rowgroup" colspan="8"><a href="{{ root }}{{ m.path }}">{{ m.snap.display_name }}</a></th></tr>
{% for h in headline if h.model is sameas m %}
{% set b = h.board %}
<tr class="{{ 'ranked' if h.best else 'unranked' }}">
<td class="workload"><a href="{{ root }}{{ m.path }}#{{ b.anchor }}">{{ b.board.workload }}</a><span class="sub">{{ b.kind }}</span></td>
{% if h.quoted is none %}
<td colspan="7" class="muted wrap">No config ranked. {{ b.nothing_ranked }}.</td>
{% else %}
{% set r = h.quoted.result %}
{% set split_in, split_out, _ = split_ranges(r) %}
<td class="cfg"><strong>{{ r.name }}</strong>{% if not h.best %} <span class="badge untrusted">untrusted, not ranked</span>{% endif %}<span class="sub">{{ r.label.short }}{% if not h.best %}; {{ untrusted_short(r) }}{% endif %}</span></td>
<td class="num">{{ cost(split_in, notes) }}</td>
<td class="num">{{ cost(split_out, notes) }}</td>
<td class="num">{{ point(r.goodput_output_tok_s_per_gpu, 1) }}</td>
<td class="num">{{ point(r.ttft_p95_ms, 0, 'ms') }}</td>
<td class="num">{{ point(r.tpot_p95_ms, 1, 'ms') }}</td>
<td>{{ gate_badge(r) }}</td>
{% endif %}
</tr>
{% endfor %}
</tbody>
{% endfor %}
</table>
{% endcall %}
{{ note_list(notes) }}
<dl class="legend">
<dt>Ranked</dt><dd>The cheapest config at the SLO that passed every check. A candidate (another precision, engine or setting) ranks only after its quality gate passes against the model's BF16 reference; a failed or inconclusive gate keeps it out, however cheap.</dd>
<dt><span class="badge untrusted">untrusted, not ranked</span></dt><dd>Nothing on that workload is ranked, so the best untrusted reference is shown for comparison. Rerun before relying on it.</dd>
<dt>Cost in / out</dt><dd>The replica's on-demand hourly price (GPU plus storage) divided by tokens served per hour at the SLO, split between input and output by measured prefill time (<a href="{{ root }}methodology.html#split">how</a>).</dd>
</dl>
<p class="section-note">{{ manifest.experiment_ids|length }} experiment{{ '' if manifest.experiment_ids|length == 1 else 's' }}, {{ manifest.run_count }} runs. <a href="{{ root }}methodology.html">Methodology</a></p>
</section>
{% endif %}

<section aria-labelledby="terms-h">
<h2 id="terms-h">Terms</h2>
<dl class="defs compact">
<dt>SLO</dt><dd>Service-level objective: the latency and error limits every result must meet.</dd>
<dt>First token (TTFT)</dt><dd>Time from sending a request to receiving the first token.</dd>
<dt>Per token (TPOT)</dt><dd>Time between output tokens after the first.</dd>
<dt>Throughput at SLO</dt><dd>Output tokens per second at the highest tested load that met the SLO (“goodput”). Cost uses this, never raw peak. <a href="{{ root }}methodology.html#goodput">More</a></dd>
<dt>p95</dt><dd>95th percentile: 95% of requests were at least this fast.</dd>
<dt>95% CI</dt><dd>Confidence interval across repeated runs. A load meets the SLO only if the interval's upper end does. <a href="{{ root }}methodology.html#ci">More</a></dd>
<dt>Quality gate</dt><dd>A candidate is scored against the model's BF16 reference on the same evaluation items. Only a pass ranks it. <a href="{{ root }}methodology.html#quality">More</a></dd>
</dl>
</section>

{{ waitlist(config) }}
{% endblock %}
