{% extends "base.html.j2" %}
{% from "_macros.html.j2" import money, estimate, methodology_footer %}
{% set title = report.title %}
{% block content %}
<header>
<h1>{{ report.title }}</h1>
</header>
{% for section in top %}
{{ section }}
{% endfor %}
<section>
<h2>Leaderboards</h2>
<p class="lede">{{ lede }} The smaller line under each value is its 95% confidence interval.</p>
<p class="lede">{{ bracket_note }}</p>
{% if unbracketed %}<p class="lede">{{ unbracketed_note }}</p>{% endif %}
</section>
{% for b in report.boards %}
<section>
<h3>{{ board_title(b) }}</h3>
<div class="table-wrap">
<table>
<thead>
<tr><th class="num">#</th><th>Config</th><th class="num">$/1M in at SLO<br>(measured split)</th><th class="num">$/1M out at SLO<br>(measured split)</th><th class="num">$/1M blended<br>at this mix</th><th class="num">{{ rank_header(b) }}</th>{% for c in b.price_columns %}<th class="num">{{ price_header(c, b.side) }}</th>{% endfor %}<th class="num">Goodput out tok/s<br>per replica</th><th class="num">per GPU</th><th class="num">Goodput load<br>(search bracket)</th><th class="num">p95 TTFT<br>at goodput</th><th class="num">p95 TPOT<br>at goodput</th><th class="num">Raw peak out tok/s<br>(no SLO)</th><th>Quality Δ / gate</th><th class="num">Cold start</th><th>Status</th><th>Recommendation</th></tr>
</thead>
<tbody>
{% for row in b.rows %}
{% set r = row.result %}
<tr class="{{ 'ranked' if row.rank is not none else 'unranked' }}">
<td class="num">{{ row.rank if row.rank is not none else '–' }}</td>
<td><strong>{{ r.name }}</strong><span class="sub">{{ r.label.text }}</span></td>
{% for rng in split_ranges(r) %}
<td class="num">{{ money(rng) }}</td>
{% endfor %}
<td class="num">{{ money(ranking_cost(r)) }}</td>
{% for c in b.price_columns %}
<td class="num">{{ money(ranking_cost(r, c)) }}</td>
{% endfor %}
<td class="num">{{ estimate(r.goodput.output_tok_s, 1) }}</td>
<td class="num">{{ estimate(r.goodput_output_tok_s_per_gpu, 1) }}</td>
<td class="num">{{ goodput_bracket(r.goodput) }}{% if row.goodput_ties %}<span class="sub">tied with {{ row.goodput_ties|join(', ') }}</span>{% endif %}</td>
<td class="num">{{ estimate(r.ttft_p95_ms, 0, 'ms') }}</td>
<td class="num">{{ estimate(r.tpot_p95_ms, 1, 'ms') }}</td>
<td class="num">{{ estimate(r.peak_output_tok_s, 1) }}<span class="sub">at {{ load_value(r.peak_load, r.load_mode) }}</span></td>
<td>{% if r.quality and r.quality.gate %}<span class="badge {{ r.quality.gate }}">{{ gate_label(r.quality.gate) }}</span>{% endif %}<span class="sub">{{ quality_text(r) }}</span></td>
<td class="num">{{ cold_text(row.cold_start) }}</td>
<td><span class="badge {{ row.status.name|lower }}">{{ row.status.value }}</span></td>
<td>{{ row.recommendation }}</td>
</tr>
{% endfor %}
</tbody>
</table>
</div>
{% if b.equal_load %}
{% set t = b.equal_load %}
<h4>Latency at equal load</h4>
<p class="lede">{{ equal_load_note }}</p>
<div class="table-wrap">
<table>
<thead>
<tr><th class="num">Load</th><th>Metric</th>{% for n in t.names %}<th class="num">{{ n }}</th>{% endfor %}<th>Verdict</th></tr>
</thead>
<tbody>
{% for p in t.points %}
<tr><td class="num">{{ load_value(p.load, t.load_mode) }}</td><td>SLO at this load</td>{% for c in p.cells %}<td class="num">{{ slo_text(c.slo_met) }}</td>{% endfor %}<td></td></tr>
{% for metric, label in equal_load_metrics %}
<tr><td class="num">{{ load_value(p.load, t.load_mode) }}</td><td>{{ label }}</td>{% for c in p.cells %}<td class="num">{% if p.lower[metric] == c.name %}<strong>{{ estimate(c.metrics.get(metric), equal_load_places.get(metric, 0), 'ms') }}</strong>{% else %}{{ estimate(c.metrics.get(metric), equal_load_places.get(metric, 0), 'ms') }}{% endif %}</td>{% endfor %}<td>{{ p.verdict(metric) }}</td></tr>
{% endfor %}
{% endfor %}
</tbody>
</table>
</div>
{% endif %}
{% set warned = b.rows|map(attribute='result')|selectattr('warnings')|list %}
{% if warned %}
<h4>Warnings</h4>
<ul class="warnings">
{% for r in warned %}
{% for w in r.warnings %}
<li><strong>{{ r.name }}</strong>: {{ w.message }}</li>
{% endfor %}
{% endfor %}
</ul>
{% endif %}
</section>
{% endfor %}
{% for section in bottom %}
{{ section }}
{% endfor %}
{{ methodology_footer(report.methodology) }}
{% endblock %}
