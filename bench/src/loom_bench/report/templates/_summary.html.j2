{% from "_macros.html.j2" import money %}
<section class="summary">
<h2>{{ summary.heading }}</h2>
<p class="lede">{{ summary.intro }}</p>
{% for m in summary.models %}
<h3>{{ m.model }}</h3>
<p>Hardware: {{ m.hardware|join('; ') }}.</p>
<div class="table-wrap">
<table>
<thead>
<tr>{% for h in headers %}<th{% if h.startswith('$') %} class="num"{% endif %}>{{ h }}</th>{% endfor %}</tr>
</thead>
<tbody>
{% for w in m.workloads %}
{% for line in w.lines %}
<tr class="{{ '' if line.quoted else 'unranked' }}">
<td>{{ w.workload }}</td>
<td>{% if line.quoted %}<strong>{{ line.config }}</strong><span class="sub">quoted</span>{% else %}{{ line.config }}{% endif %}</td>
<td>{{ line.standing }}</td>
<td>{{ line.goodput }}</td>
<td class="num">{{ money(line.cost_input) }}</td>
<td class="num">{{ money(line.cost_output) }}</td>
<td class="num">{{ money(line.cost_blended) }}</td>
<td>{{ line.quality }}</td>
</tr>
{% endfor %}
{% endfor %}
</tbody>
</table>
</div>
{% for w in m.workloads %}
<h4>{{ w.workload }} <span class="sub">{{ w.shape }}</span></h4>
<ul>
{% for p in w.points %}
<li{% if p.startswith('Caveat') or p.startswith('No cost') or p.startswith('Alternative SLO') %} class="caveat"{% endif %}>{{ p }}</li>
{% endfor %}
</ul>
{% endfor %}
<h4>Quality</h4>
<ul>
{% for q in m.quality %}
<li>{{ q }}</li>
{% endfor %}
</ul>
{% endfor %}
</section>
