        "method": "geometric mean, Student-t interval on the log scale (log_t); arithmetic interval clipped at 0 if a repetition is 0"
      },
      {
        "metrics": "server queue time, measurement window",
        "method": "geometric mean, Student-t interval on the log scale (log_t); arithmetic interval clipped at 0 if a repetition is 0"
      },
      {
        "metrics": "error rate, SLO attainment, cache fractions and hit rates",
        "method": "arithmetic mean of per-run proportions, Student-t interval clipped to [0, 1] (t_clipped)"
      },
      {
