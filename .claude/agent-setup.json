{
  "protect": {
    "paths": [
      "**/tests/**",
      "**/test/**",
      "**/test_*.py",
      "**/*_test.py",
      "**/conftest.py",
      "pytest.ini",
      "services/platform_common/src/loom_platform/testing.py",
      "bench/src/loom_bench/providers/runpod_fake.py",
      "bench/src/loom_bench/providers/runpod_fake_pod.json",
      "bench/tests/**",
      "services/platform_common/tests/**",
      "services/gateway/tests/**",
      "services/billing/tests/**",
      "services/podproxy/tests/**",
      "services/devstack/tests/**",
      "apps/web/src/**/*.test.ts",
      ".github/workflows/ci.yml",
      "apps/web/vitest.config.ts",
      "apps/web/package.json",
      "scripts/flaky_report.py",
      "services/billing/src/loom_billing/stripe_stub.py",
      "services/devstack/src/loom_devstack/m3_acceptance.py",
      "infra/aws/platform/tests/**",
      ".github/terraform/**",
      "docs/phase1-m3-spec.md"
    ],
    "testWriters": [
      "agent-setup:test-writer"
    ]
  },
  "retro": {
    "path": ".claude/agent-retros.md",
    "minAgents": 2
  },
  "holdout": {
    "path": ".holdout",
    "command": "LOOM_TEST_DATABASE_URL=postgresql+psycopg://loom:loom@localhost:5432/loom LOOM_TEST_REDIS_URL=redis://localhost:6379/15 PYTHONPATH=services/billing/tests uv run --frozen pytest -q -n auto -p no:cacheprovider .holdout"
  }
}
